{
  "name": "nexus",
  "version": "4.4.2",
  "type": "module",
  "scripts": {
    "build:server": "rm -rf dist-server && tsc -p tsconfig.server.build.json",
    "start": "npm run build:server && node dist-server/server.js",
    "dev": "node --watch server.js",
    "setup": "node scripts/setup.js",
    "typecheck:server": "tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "node-pty": "^1.1.0",
    "playwright": "^1.58.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "typescript": "^6.0.2"
  }
}
