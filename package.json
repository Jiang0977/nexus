{
  "name": "nexus",
  "version": "4.4.2",
  "type": "module",
  "scripts": {
    "start": "bash ./start.sh",
    "start:rust-server": "bash ./start.sh",
    "dev": "cargo build --manifest-path rust-runtime/Cargo.toml --bin nexus-server && NEXUS_SERVER_EXECUTABLE=./rust-runtime/target/debug/nexus-server bash ./start.sh",
    "setup": "cargo run --manifest-path rust-runtime/Cargo.toml --release --bin nexus-setup --",
    "build:rust-setup": "cargo build --manifest-path rust-runtime/Cargo.toml --release --bin nexus-setup",
    "build:rust-server": "cargo build --manifest-path rust-runtime/Cargo.toml --release --bin nexus-server",
    "build:rust-codex-home": "cargo build --manifest-path rust-runtime/Cargo.toml --release --bin nexus-codex-home",
    "build:rust-task-runtime": "cargo build --manifest-path rust-runtime/Cargo.toml --release --bin nexus-task-runtime",
    "build:rust-pty-runtime": "cargo build --manifest-path rust-runtime/Cargo.toml --release --bin nexus-pty-runtime",
    "build:rust-launch-runtime": "cargo build --manifest-path rust-runtime/Cargo.toml --release --bin nexus-window-launch-runtime",
    "build:rust-session-runtime": "cargo build --manifest-path rust-runtime/Cargo.toml --release --bin nexus-session-runtime",
    "build:rust-runtimes": "cargo build --manifest-path rust-runtime/Cargo.toml --release --bin nexus-task-runtime --bin nexus-pty-runtime --bin nexus-window-launch-runtime --bin nexus-session-runtime"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "playwright": "^1.58.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "typescript": "^6.0.2"
  }
}
