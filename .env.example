# =============================================================
# Nexus 配置文件
# 使用方法: 运行 ./setup.sh 自动生成安全密钥与一次性密码并配置服务
# 手动配置时请务必填写安全且非公开的密码 hash 和 JWT secret
# =============================================================

# JWT 签名密钥
# 建议通过 ./setup.sh 自动生成，或使用 openssl rand -hex 32 生成独立高强度密钥
JWT_SECRET=

# 登录密码的 bcrypt hash
# 建议通过 ./setup.sh 自动生成一次性密码，或自行生成 bcrypt hash (cost >= 12)
ACC_PASSWORD_HASH=

# 要 attach 的 tmux session 名（不存在会自动创建）
TMUX_SESSION=main

# 会话后端：默认 tmux。native 仍是 opt-in，需要配合 nexus-native-pty.service。
# 可通过 UI 保存到 data/session-backend.json，也可在这里显式设置。
# NEXUS_SESSION_BACKEND=native

# 工作区根目录（Claude 能访问的文件系统路径）
# 改为你实际的工作目录，例如 /home/yourname/work 或 /root
WORKSPACE_ROOT=/home

# 持久化数据目录（默认相对仓库根的 data/；独立部署多个实例时建议显式指定）
# 相对路径会按项目根目录解析，绝对路径会直接使用
# NEXUS_DATA_DIR=var/nexus-data

# 服务监听地址
# 默认仅监听本地回环地址 127.0.0.1，如需外部访问请配合反向代理或显式修改
HOST=127.0.0.1

# 服务监听端口
PORT=59000

# 终端 WebSocket 心跳间隔（毫秒）；必须为正数，无效值回退到 10000
NEXUS_WS_HEARTBEAT_MS=10000

# Claude 启动时注入的代理（用于访问 Anthropic API，不需要则留空）
# 格式: http://host:port
CLAUDE_PROXY=

# GitHub 仓库（用于检查更新），格式: owner/repo
# Fork 用户改为自己的 repo
GITHUB_REPO=Jiang0977/nexus
