# System-service example. Edit User, Group, HOME, PATH and installation paths before use.
[Unit]
Description=Nexus service
After=network-online.target tailscaled.service nexus-native-pty.service
Wants=network-online.target nexus-native-pty.service

[Service]
Type=simple
User=nexus
Group=nexus
WorkingDirectory=/opt/nexus
Environment=HOME=/home/nexus
Environment=USER=nexus
Environment=SHELL=/bin/bash
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=PATH=/home/nexus/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/bash /opt/nexus/start.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillMode=control-group

[Install]
WantedBy=multi-user.target
