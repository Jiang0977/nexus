[Unit]
Description=Nexus service
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=jiang
Group=jiang
WorkingDirectory=/home/jiang/workspace/rust/nexus
Environment=HOME=/home/jiang
Environment=USER=jiang
Environment=SHELL=/bin/bash
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=PATH=/home/jiang/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/bash /home/jiang/workspace/rust/nexus/start.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillMode=control-group

[Install]
WantedBy=multi-user.target
