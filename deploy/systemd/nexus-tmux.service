[Unit]
Description=Persistent tmux server for Nexus
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=demo
Group=demo
WorkingDirectory=/home/demo/workspace/rust/nexus
Environment=HOME=/home/demo
Environment=USER=demo
Environment=SHELL=/bin/bash
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=PATH=/home/demo/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/bash /home/demo/workspace/rust/nexus/scripts/nexus-tmux-service.sh start-foreground
ExecStartPost=/usr/bin/bash /home/demo/workspace/rust/nexus/scripts/nexus-tmux-service.sh ensure-session
ExecStop=/usr/bin/bash /home/demo/workspace/rust/nexus/scripts/nexus-tmux-service.sh stop
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillMode=control-group

[Install]
WantedBy=multi-user.target
