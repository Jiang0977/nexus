[Unit]
Description=Persistent tmux server for Nexus
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=jiang
Group=jiang
WorkingDirectory=/home/jiang/workspace/rust/nexus
Environment=HOME=/home/jiang
Environment=USER=jiang
Environment=SHELL=/bin/bash
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=PATH=/home/jiang/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/bash /home/jiang/workspace/rust/nexus/scripts/nexus-tmux-service.sh start
ExecStop=/usr/bin/bash /home/jiang/workspace/rust/nexus/scripts/nexus-tmux-service.sh stop
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
