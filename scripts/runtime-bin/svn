#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/nexus-runtime-proxy.sh"

SOURCE_HOME="$(nexus_runtime_source_home)"
REAL_SVN_BIN="$(nexus_runtime_resolve_real_command svn "${SCRIPT_DIR}/$(basename -- "${BASH_SOURCE[0]}")")"

for arg in "$@"; do
  case "$arg" in
    --config-dir|--config-dir=*)
      exec "$REAL_SVN_BIN" "$@"
      ;;
  esac
done

if [ -n "$SOURCE_HOME" ]; then
  exec "$REAL_SVN_BIN" --config-dir "${SOURCE_HOME}/.subversion" "$@"
fi

exec "$REAL_SVN_BIN" "$@"
